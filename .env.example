# a.tune 프론트엔드 환경 변수 예시 (실제 값은 커밋 금지).
# Vite는 빌드 시 VITE_ 접두사 변수만 클라이언트 번들에 노출한다.
# => 여기에 적는 값은 모두 "공개되어도 되는" 클라이언트용 식별자여야 한다.
# 진짜 secret(서버 키, AWS 자격증명, VAPID private key)은 .env에 두지 말고
# CI Secrets / 서버 환경에서만 관리한다.

# 백엔드 API 베이스 URL (예: https://api.example.com)
VITE_API_BASE_URL=

# 관리자 화면에서 목 데이터 사용 여부 (true/false)
VITE_ADMIN_USE_MOCK=false

# 소셜 로그인 클라이언트 식별자 (공개 식별자)
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_APP_KEY=
VITE_APPLE_CLIENT_ID=

# 웹 푸시 공개 키 (VAPID public key — 공개용. private key는 절대 여기 두지 말 것)
# CI에서는 GitHub Secrets의 VAPID_PUBLIC_KEY로 주입된다.
VITE_VAPID_PUBLIC_KEY=
